# Copy to .env and fill in. See docs/routine_runner_design_spec.md §9.
# run.py loads this file automatically. Commented lines show the default value.

# --- Household identity ------------------------------------------------------
RR_HOUSEHOLD_ID=home
RR_HOUSEHOLD_NAME=Home

# Where the SQLite databases live.
# RR_DATA_DIR=./data

# --- Auth / tokens -----------------------------------------------------------
# Sign device tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RR_JWT_SECRET=
# Device session lifetime (days) and single-use enrolment token TTL (seconds).
# RR_TOKEN_TTL_DAYS=365
# RR_ENROL_TTL_SECONDS=300

# --- TLS / hostname (spec §9.1) ----------------------------------------------
RR_HOSTNAME=routines.philim.com
# Cloudflare token scoped to edit DNS on this zone only
CF_API_TOKEN=

# --- Web server (run.py serve) -----------------------------------------------
# RR_HOST=127.0.0.1
# RR_PORT=8000
# RR_LOG_LEVEL=info

# --- Notifications (spec §9.4): ntfy | noop ----------------------------------
RR_NOTIFY_BACKEND=ntfy
RR_NTFY_TOPIC=

# --- Parent email OTP login (/parent) via Resend -----------------------------
# Create a key at https://resend.com/api-keys — leave unset to use noop (logged only)
RESEND_API_KEY=
RR_RESEND_FROM=Routine Runner <onboarding@resend.dev>
# RR_EMAIL_BACKEND=resend   # defaults to resend when RESEND_API_KEY is set, else noop
# RR_OTP_TTL_SECONDS=600
# RR_OTP_RESEND_SECONDS=60

# --- Development only ---------------------------------------------------------
# DANGER: enables /parent/dev-login, which grants a parent session with NO
# authentication. Leave unset/false in production.
# RR_DEV_MODE=false
